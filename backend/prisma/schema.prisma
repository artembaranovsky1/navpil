datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum MemberRole {
  owner
  member
}

enum ItemCategory {
  food
  transport
  housing
  entertainment
  shopping
  other
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships      RoomMember[]
  addedItems       Item[]       @relation("ItemAddedBy")
  paidItems        Item[]       @relation("ItemPaidBy")
  sentPayments     Payment[]    @relation("PaymentFrom")
  receivedPayments Payment[]    @relation("PaymentTo")
  createdPayments  Payment[]    @relation("PaymentCreatedBy")
}

model Room {
  id          String    @id @default(uuid())
  name        String
  description String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  inviteCode  String    @unique
  createdAt   DateTime  @default(now())

  members  RoomMember[]
  items    Item[]
  payments Payment[]
}

model RoomMember {
  room     Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     MemberRole @default(member)
  joinedAt DateTime   @default(now())

  @@id([roomId, userId])
  @@index([userId])
}

model Item {
  id           String       @id @default(uuid())
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId       String
  name         String
  description  String?
  amount       Decimal      @db.Decimal(12, 2)
  category     ItemCategory
  addedBy      User         @relation("ItemAddedBy", fields: [addedById], references: [id])
  addedById    String
  paidBy       User         @relation("ItemPaidBy", fields: [paidById], references: [id])
  paidById     String
  date         DateTime     @db.Date
  // id учасників, між якими ділиться витрата
  splitBetween String[]
  createdAt    DateTime     @default(now())

  @@index([roomId])
}

model Payment {
  id          String   @id @default(uuid())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      String
  from        User     @relation("PaymentFrom", fields: [fromId], references: [id])
  fromId      String
  to          User     @relation("PaymentTo", fields: [toId], references: [id])
  toId        String
  amount      Decimal  @db.Decimal(12, 2)
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  @@index([roomId])
}
